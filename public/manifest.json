{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "WorldLibrary",
  "short_name": "WorldLibrary",
  "description": "Share and borrow books from the world",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#4f46e5",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "categories": ["books", "education", "lifestyle"],
  "lang": "en",
  "scope": "/",
  "prefer_related_applications": false
}
